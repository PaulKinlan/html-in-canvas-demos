{
  "name": "Canvas window",
  "short_name": "Canvas window",
  "description": "A test app whose title bar and content are drawn by one canvas.",
  "id": "/window-chrome/app.html",
  "start_url": "/window-chrome/app.html",
  "scope": "/window-chrome/",
  "display": "standalone",
  "display_override": ["window-controls-overlay"],
  "theme_color": "#1d2330",
  "background_color": "#1d2330",
  "icons": [
    { "src": "/window-chrome/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/window-chrome/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/window-chrome/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
