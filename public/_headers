# Where the browser sends its own reports about a page: a crashed tab (out of
# memory or unresponsive), an intervention, a deprecated call and a broken
# content security policy. Previews have no Worker, so every copy of the site
# reports to the production host; src/reports.js files each report under the
# origin of its page. The policy below blocks nothing (Report-Only): it reports
# a script or frame loaded from plain http.
/*
  Reporting-Endpoints: default="https://html-in-canvas.page/api/reports"
  Report-To: {"group":"default","max_age":86400,"endpoints":[{"url":"https://html-in-canvas.page/api/reports"}]}
  Content-Security-Policy-Report-Only: default-src * data: blob: 'unsafe-inline' 'unsafe-eval'; script-src https: 'self' blob: 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; frame-src https: 'self' blob: data: about:; report-to default

# Let other sites load the drop-in elements as ES modules.
/lib/*
  Access-Control-Allow-Origin: *

# Lets the capture tests load this one image with CORS from the other origin.
/capture/swatch.svg
  Access-Control-Allow-Origin: *

# Lets the video tests load the clips with CORS from the other origin.
/media/*
  Access-Control-Allow-Origin: *

# Gives this one document cross-origin isolation (SharedArrayBuffer) without
# COOP and COEP on the pages that embed it. Used by /transports-2/.
/transports-2/isolated
  Document-Isolation-Policy: isolate-and-credentialless
/transports-2/isolated.html
  Document-Isolation-Policy: isolate-and-credentialless

# The prerender comparison on /iframe-tiles/: only this page opts in to
# loading its cross-origin frames while it is being prerendered.
/iframe-tiles/prerendered
  Supports-Loading-Mode: prerender-cross-origin-frames
/iframe-tiles/prerendered.html
  Supports-Loading-Mode: prerender-cross-origin-frames
