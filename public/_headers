# Let other sites load the drop-in elements as ES modules.
/lib/*
  Access-Control-Allow-Origin: *

# Lets the capture tests load this one image with CORS from the other origin.
/capture/swatch.svg
  Access-Control-Allow-Origin: *

# Lets the video tests load the clips with CORS from the other origin.
/media/*
  Access-Control-Allow-Origin: *

# Gives this one document cross-origin isolation (SharedArrayBuffer) without
# COOP and COEP on the pages that embed it. Used by /transports-2/.
/transports-2/isolated
  Document-Isolation-Policy: isolate-and-credentialless
/transports-2/isolated.html
  Document-Isolation-Policy: isolate-and-credentialless
