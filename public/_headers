# Let other sites load the drop-in elements as ES modules.
/lib/*
  Access-Control-Allow-Origin: *

# Lets the capture tests load this one image with CORS from the other origin.
/capture/swatch.svg
  Access-Control-Allow-Origin: *

# Lets the video tests load the clips with CORS from the other origin.
/media/*
  Access-Control-Allow-Origin: *
