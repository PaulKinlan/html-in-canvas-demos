{
  // Deploy with: npx wrangler deploy
  // The cross-origin demo expects a second copy on another origin:
  //   npx wrangler deploy --name html-in-canvas-remote
  "name": "html-in-canvas-demos",
  "compatibility_date": "2026-11-01",
  // Static files are served first; src/index.js only sees /api/* and misses.
  "main": "src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash"
  },
  // Cross-context demos: relay rooms (WebRTC signalling) and Workers AI.
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "ai": { "binding": "AI" }
}
