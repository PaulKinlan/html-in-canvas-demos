{
  // Deploy with: npx wrangler deploy
  // The cross-origin demo expects a second copy on another origin:
  //   npx wrangler deploy --name html-in-canvas-remote
  "name": "html-in-canvas-demos",
  "compatibility_date": "2026-11-01",
  // Static files are served first; src/index.js only sees /api/* and misses.
  "main": "src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Cross-context demos: relay rooms (WebRTC signalling) and Workers AI.
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "ai": { "binding": "AI" },
  // Crash and error reports from every copy of the site: src/reports.js.
  // The id names the database and is not a credential.
  "d1_databases": [{ "binding": "REPORTS", "database_name": "html-in-canvas-reports", "database_id": "e65679c5-3d56-4d92-9ebe-1128d7184917" }]
  // Optional secrets (never in this file): TURN_KEY_ID and TURN_KEY_API_TOKEN,
  // a Cloudflare Realtime TURN key. With them /api/x/ice also hands out TURN
  // servers, so /remote/ connects across mobile and office networks.
  //   npx wrangler secret put TURN_KEY_ID
  //   npx wrangler secret put TURN_KEY_API_TOKEN
}
