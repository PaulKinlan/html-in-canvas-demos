{
  "name": "html-in-canvas-demos",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node tools/site/build.mjs",
    "build": "node tools/site/build.mjs",
    "pages": "node tools/site/build.mjs --list",
    "tools": "node tools/site/tools.mjs",
    "check:pages": "node tools/site/build.mjs --check",
    "check:merge": "node tools/site/check-merge.mjs",
    "dev": "node tools/site/build.mjs && npx wrangler dev",
    "deploy": "node tools/site/build.mjs && npx wrangler deploy && npx wrangler deploy --name html-in-canvas-remote",
    "check:jank": "node tools/jank/check.mjs",
    "check:gfx": "node tools/gfx/check.mjs",
    "reports": "node tools/reports/list.mjs",
    "build:fx": "node tools/bundle/fx.mjs",
    "check:fx": "node tools/bundle/fx.mjs --check",
    "build:plan": "node tools/chrome-apis/build.mjs",
    "record:probes": "node tools/chrome-apis/record-probes.mjs",
    "check:ideas": "node tools/element-ideas/check.mjs",
    "record:elements": "node tools/elements/record.mjs"
  }
}
